# ========================================================
# AgencyOS - Production & Local Development Configuration
# ========================================================

# Application Mode & Ports
NODE_ENV=production
BACKEND_PORT=3000
FRONTEND_PORT=5000

# Base URLs
FRONTEND_URL=http://localhost:5000
NEXT_PUBLIC_BACKEND_URL=http://localhost:3000
BACKEND_INTERNAL_URL=http://localhost:3000

# PostgreSQL (pgvector ready)
POSTGRES_USER=agency_admin
POSTGRES_PASSWORD=AgencyOS_SecurePass_2026!
POSTGRES_DB=agencyos_db
DATABASE_URL=postgresql://agency_admin:AgencyOS_SecurePass_2026!@localhost:5432/agencyos_db

# Redis 7 (Queues & Sessions)
REDIS_URL=redis://localhost:6379

# Authentication & Security
JWT_SECRET=super-secret-jwt-key-replace-in-production-random-64-chars

# Telegram Bot API (Create via @BotFather)
# Required for Destination Verification & Channel Publishing
TELEGRAM_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ

# AI Systems (Multi-Tier Engine)
# Option 1: Local Ollama (Recommended for 16 GB Laptop - 100% Free & Private)
OLLAMA_HOST=http://localhost:11434
AI_MODEL=qwen2.5:3b
EMBEDDING_MODEL=embeddinggemma

# Option 2: OpenAI API (Optional Fallback)
OPENAI_API_KEY=sk-optional-openai-key-here

# Option 3: Built-in Heuristic Copywriter & Vector Hash Engine
# (Always active with 100% offline uptime if no external LLM is reachable)
