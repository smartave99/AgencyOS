# ============================================================================
# AgencyOS configuration
#
# Copy to .env and fill in. Everything marked REQUIRED must be set; there are no
# working defaults on purpose. Never commit a real .env.
# The platform's own settings (social network keys, storage, email) stay as documented in
# .env.example; only what AgencyOS adds or relies on is listed here.
# ============================================================================

# --- Addresses (REQUIRED) ---------------------------------------------------
# Local development (pnpm run dev):
FRONTEND_URL="http://localhost:4200"
NEXT_PUBLIC_BACKEND_URL="http://localhost:3000"
BACKEND_INTERNAL_URL="http://localhost:3000"
# Docker Compose (docker-compose.agencyos.yml serves everything on one port):
#   FRONTEND_URL="http://localhost:5000"
#   NEXT_PUBLIC_BACKEND_URL="http://localhost:5000/api"

# --- Data stores (REQUIRED) ---------------------------------------------------
# PostgreSQL 16 or newer. The schema is managed by Prisma migrations:
#   pnpm run prisma-migrate        (applies them; see AGENCYOS_GUIDE.md)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/agencyos"
REDIS_URL="redis://localhost:6379"

# --- Workflow engine (REQUIRED: the backend and orchestrator will not start without it)
# The platform schedules its own social posts with Temporal. AgencyOS campaigns use their own
# database-backed queue (below) but the application still needs Temporal to boot.
TEMPORAL_ADDRESS="localhost:7233"

# --- Security (REQUIRED) ----------------------------------------------------
# Long random string, unique to this install: openssl rand -hex 48
JWT_SECRET=""

# --- Telegram ---------------------------------------------------------------
# Create a bot with @BotFather and paste its token. Without it destinations cannot be
# authorized and nothing can be sent; the dashboard says so. Use a bot dedicated to
# AgencyOS, not one shared with other tools. (TELEGRAM_TOKEN is used if this is empty.)
AGENCY_TELEGRAM_BOT_TOKEN=""

# How AgencyOS hears about /authorize and /revoke in your chats. Pick ONE:
#  a) Webhook (recommended in production): a public https URL that reaches
#     POST /agency/telegram/webhook on the backend, plus a secret Telegram sends back.
#       AGENCY_TELEGRAM_WEBHOOK_URL="https://your-domain.example/api/agency/telegram/webhook"
#       AGENCY_TELEGRAM_WEBHOOK_SECRET="<openssl rand -hex 24>"
#  b) Long polling (default when no webhook URL is set): works behind a firewall, one
#     process at a time holds the lease.
AGENCY_TELEGRAM_WEBHOOK_URL=""
AGENCY_TELEGRAM_WEBHOOK_SECRET=""

# --- Publishing queue -----------------------------------------------------------
# The dispatcher sends due posts. It is OFF unless you turn it on, so a scheduled campaign
# waits (and the dashboard shows a banner) until it runs in at least one process.
AGENCY_SCHEDULER_ENABLED="true"
# AGENCY_DISPATCH_INTERVAL_MS="15000"   # how often it looks for due posts (min 2000)
# AGENCY_JOB_MAX_ATTEMPTS="5"           # then the post is marked failed and the team notified
# AGENCY_JOB_BACKOFF_SECONDS="60"       # doubles after each failed attempt
# AGENCY_JOB_LEASE_SECONDS="120"        # a send that outlives this is re-checked by a human
# AGENCY_SEND_DELAY_MS="1100"           # pause between sends to one chat (Telegram allows ~20/min)
# AGENCY_CONSENT_VALID_DAYS="365"       # how long an admin's authorization lasts

# --- AI (optional: nothing else depends on it) --------------------------------
# Copy suggestions use a local Ollama model if reachable, otherwise a fill-in-the-blank
# template that is labelled as such. Nothing is sent to a third party unless you opt in.
OLLAMA_HOST="http://localhost:11434"
AI_MODEL="qwen2.5:3b"
EMBEDDING_MODEL="embeddinggemma"
# AGENCY_AI_TIMEOUT_MS="90000"
# AGENCY_EMBED_TIMEOUT_MS="30000"
# Which AI answers (local model, Claude Code, Codex CLI, Antigravity CLI, or an API) is chosen
# in Settings -> AI and Copilot. On a server, outside AI services additionally need:
# AGENCY_ALLOW_EXTERNAL_AI="true"
# A key set here is read as that provider's key when none is saved in Settings:
# OPENAI_API_KEY=""
# OPENAI_MODEL="gpt-4o-mini"
# ANTHROPIC_API_KEY=""
# GEMINI_API_KEY=""
# Desktop app: the AI command-line tools are updated once a day; set to off to stop that.
# AGENCY_AI_TOOL_UPDATES="off"

# --- Docker Compose only (docker-compose.agencyos.yml) -------------------------
# POSTGRES_PASSWORD=""          # password for the agencyos database user
# TEMPORAL_DB_PASSWORD=""       # password for Temporal's own database

# --- One person, no sign-in (the Windows desktop app sets these itself) --------------
# With AGENCYOS_LOCAL=true the first visit opens the local workspace by itself and the sign-in,
# sign-up and password-reset routes are switched off. The backend and the frontend must share
# the same key; it is sent server to server and never reaches the browser. Leave both unset on a
# server where people sign in.
# AGENCYOS_LOCAL="true"
# AGENCYOS_LOCAL_KEY=""         # openssl rand -hex 32

# --- Tests only -----------------------------------------------------------------
# A throwaway database that already has the schema; integration and HTTP tests skip
# themselves when it is unset. Never point it at real data.
# AGENCYOS_TEST_DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/agencyos_test"
